{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "priority-replay", "main": "worker/index.ts",
  "compatibility_date": "2026-09-19", "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "priority", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "REPLAYS", "bucket_name": "priority-replays"}],
  "vars": {"ACCESS_ISSUER": "https://REPLACE.cloudflareaccess.com", "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUDIENCE"},
  "observability": {"enabled": false}
}
